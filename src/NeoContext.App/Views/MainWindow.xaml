<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoContext.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NeoContext.App.ViewModels"
    xmlns:views="using:NeoContext.App.Views"
    xmlns:services="using:NeoContext.App.Services">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (the content extends into it) -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18" />
                <TextBlock Text="NeoContext" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border Visibility="{x:Bind ViewModel.IsElevated}" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Uid="AdminBadge" Text="Administrator" FontSize="11"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="250"
            MenuItemsSource="{x:Bind ViewModel.Sections}"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:SectionItem">
                    <NavigationViewItem Content="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Description}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <!-- Entry pages -->
                <Grid x:Name="EntriesPanel" Padding="32,16,32,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBox" Grid.Column="1" Width="260" VerticalAlignment="Center"
                                        PlaceholderText="Search" QueryIcon="Find"
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <AutoSuggestBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" Invoked="OnClearSearch" />
                            </AutoSuggestBox.KeyboardAccelerators>
                        </AutoSuggestBox>
                        <Button x:Uid="RefreshButton" Grid.Column="2" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                                AutomationProperties.Name="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                    <!-- File type picker: only on the "File types" page -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ToVisible(ViewModel.IsFileTypesPage), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FileTypeChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTypeChoice">
                                    <Button Content="{x:Bind Label}" Tag="{x:Bind}" Click="OnFileTypeGroupClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Uid="ExtensionBox" PlaceholderText="Extension, e.g. mp4" QueryIcon="Find"
                                            TextChanged="OnExtensionTextChanged" QuerySubmitted="OnExtensionSubmitted" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="{x:Bind ViewModel.FileTypeSummary, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Uid="ClearFileTypes" Grid.Column="2" Content="Clear"
                                    Command="{x:Bind ViewModel.ClearExtensionsCommand}"
                                    Visibility="{x:Bind ToVisible(ViewModel.HasSelectedExtensions), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <InfoBar
                             IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                             Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind ViewModel.NoticeActionText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasNoticeAction, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RunNoticeActionCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    </StackPanel>

                    <ProgressRing x:Uid="BusyRing" Grid.Row="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" />

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Spacing="8"
                                Visibility="{x:Bind ShowEmptyText(ViewModel.IsEmpty, ViewModel.IsBusy), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Uid="ClearSearchButton" Content="Clear search" HorizontalAlignment="Center"
                                         Command="{x:Bind ViewModel.ClearSearchCommand}"
                                         Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                    </StackPanel>

                    <ListView x:Uid="EntriesList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="OnEntryClick"
                              Padding="0,0,0,24">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryViewModel">
                                <Grid Padding="16,10" ColumnSpacing="16" CornerRadius="6" BorderThickness="1"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="24" Height="24" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind KindLabel}">
                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="24" Height="24"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                  Visibility="{x:Bind NoIcon, Mode=OneWay}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <TextBlock services:Highlight.Text="{x:Bind Name}" services:Highlight.Query="{x:Bind Query}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Secondary}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Visibility="{x:Bind ShowSection}" CornerRadius="4" Padding="6,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind SectionLabel}" FontSize="11" />
                                        </Border>
                                        <Border Visibility="{x:Bind ShowShiftBadge}" CornerRadius="4" Padding="6,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock x:Uid="ShiftBadge" Text="Shift" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="220"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="3" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{x:Bind Name}"
                                                  IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" />

                                    <Button x:Uid="MoreButton" Grid.Column="4" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                            AutomationProperties.Name="More options" ToolTipService.ToolTip="More options">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem x:Uid="Menu_Details" Text="Details" Command="{x:Bind ShowDetailsCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Menu_Rename" Text="Rename" Command="{x:Bind RenameCommand}" IsEnabled="{x:Bind CanRename}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_OpenLocation" Text="Open location" Command="{x:Bind OpenLocationCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_CopyLocation" Text="Copy location" Command="{x:Bind CopyLocationCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Menu_Delete" Text="Delete" Command="{x:Bind DeleteCommand}" IsEnabled="{x:Bind CanDelete}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Settings page -->
                <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed" />

                <!-- Details overlay: a click outside the card closes it -->
                <Grid x:Name="DetailsOverlay" Background="#80000000" Tapped="OnOverlayTapped"
                      Visibility="{x:Bind ToVisible(ViewModel.IsDetailsOpen), Mode=OneWay}">
                    <Border Tapped="OnCardTapped" MaxWidth="520" MaxHeight="560" Margin="24" Padding="24" CornerRadius="8"
                            BorderThickness="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.DetailsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DetailRow">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Uid="DetailsCopy" Command="{x:Bind ViewModel.CopyDetailsLocationCommand}" />
                                <Button x:Uid="DetailsClose" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CloseDetailsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
