<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoContext.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NeoContext.App.ViewModels"
    xmlns:views="using:NeoContext.App.Views"
    xmlns:services="using:NeoContext.App.Services">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (the content extends into it) -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18" />
                <TextBlock Text="NeoContext" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border Visibility="{x:Bind ViewModel.IsElevated}" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Uid="AdminBadge" Text="Administrator" FontSize="11"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="250"
            SelectionChanged="OnNavigationSelectionChanged">

            <!-- The page list is built in MainWindow.xaml.cs, because the groups are expandable. -->
            <Grid>
                <!-- Entry pages -->
                <Grid x:Name="EntriesPanel" Padding="32,16,32,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderGrid" ColumnSpacing="8" SizeChanged="OnHeaderSizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock MinWidth="160" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" />
                        <!-- The description gets the whole width, so it wraps by words instead of squeezing into the title column. -->
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBox" Grid.Column="1" Width="260" VerticalAlignment="Center"
                                        PlaceholderText="Search" QueryIcon="Find"
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <AutoSuggestBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" Invoked="OnClearSearch" />
                            </AutoSuggestBox.KeyboardAccelerators>
                        </AutoSuggestBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="NewItemBtn" x:Uid="NewItemBtn" Command="{x:Bind ViewModel.BeginNewCommand}"
                                    Visibility="{x:Bind ToVisible(ViewModel.CanCreate), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock x:Name="NewItemLabel" x:Uid="NewItemLabel" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TakeOwnershipBtn" x:Uid="TakeOwnershipBtn" Command="{x:Bind ViewModel.TakeOwnershipForPageCommand}"
                                    Visibility="{x:Bind ToVisible(ViewModel.ShowTakeOwnership), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE83D;" FontSize="14" />
                                    <TextBlock x:Name="TakeOwnershipLabel" x:Uid="TakeOwnershipLabel" />
                                </StackPanel>
                            </Button>
                            <DropDownButton x:Name="MoreBtn" x:Uid="MoreBtn" Visibility="{x:Bind ToVisible(ViewModel.ShowMoreCommands), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <TextBlock x:Name="MoreLabel" x:Uid="MoreLabel" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="4">
                                            <Button x:Uid="ChooseCustomPathButton" Command="{x:Bind ViewModel.ChooseCustomPathCommand}"
                                                    Visibility="{x:Bind ToVisible(ViewModel.IsCustomPathPage), Mode=OneWay}" />
                                            <Button x:Uid="RestoreWinXButton" Command="{x:Bind ViewModel.RestoreWinXDefaultsCommand}"
                                                    Visibility="{x:Bind ToVisible(ViewModel.IsWinXPage), Mode=OneWay}" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="RestartExplorerBtn" x:Uid="RestartExplorerBtn" Command="{x:Bind ViewModel.RestartExplorerCommand}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <Button x:Uid="RefreshButton" Grid.Column="3" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh"
                                AutomationProperties.Name="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">

                    <!-- File type picker: only on the "File types" page -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ToVisible(ViewModel.IsFileTypesPage), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FileTypeChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTypeChoice">
                                    <Button Content="{x:Bind Label}" Tag="{x:Bind}" Click="OnFileTypeGroupClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Uid="ExtensionBox" PlaceholderText="Extension, e.g. mp4" QueryIcon="Find"
                                            TextChanged="OnExtensionTextChanged" QuerySubmitted="OnExtensionSubmitted" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="{x:Bind ViewModel.FileTypeSummary, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Uid="ClearFileTypes" Grid.Column="2" Content="Clear"
                                    Command="{x:Bind ViewModel.ClearExtensionsCommand}"
                                    Visibility="{x:Bind ToVisible(ViewModel.HasSelectedExtensions), Mode=OneWay}" />
                        </Grid>
                        <ComboBox Header="{x:Bind ViewModel.ExtensionPerceivedHeader, Mode=OneWay}" MinWidth="260"
                                  ItemsSource="{x:Bind ViewModel.ExtensionPerceivedChoices}" DisplayMemberPath="Label"
                                  SelectedIndex="{x:Bind ViewModel.ExtensionPerceivedIndex, Mode=TwoWay}"
                                  Visibility="{x:Bind ToVisible(ViewModel.HasSingleExtension), Mode=OneWay}" />
                    </StackPanel>

                    <!-- Perceived type and folder type pickers -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ToVisible(ViewModel.IsChoicePage), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PickerChoices, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PickerChoice">
                                    <Button Content="{x:Bind Label}" Tag="{x:Bind}" Click="OnPickerChoiceClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.PickerSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Menu analysis: a path, the pickers, or a dropped file or folder -->
                    <Border AllowDrop="True" DragOver="OnAnalysisDragOver" Drop="OnAnalysisDrop" Padding="12" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ToVisible(ViewModel.IsAnalysisPage), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="Analysis_Path" Text="{x:Bind ViewModel.AnalysisText, Mode=TwoWay}" KeyDown="OnAnalysisKeyDown" />
                                <Button x:Uid="Analysis_BrowseFile" Grid.Column="1" VerticalAlignment="Bottom" Click="OnAnalysisBrowseFile" />
                                <Button x:Uid="Analysis_BrowseFolder" Grid.Column="2" VerticalAlignment="Bottom" Click="OnAnalysisBrowseFolder" />
                                <Button x:Uid="Analysis_Run" Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.AnalyzeCommand}" />
                            </Grid>
                            <TextBlock x:Uid="Analysis_Hint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PickerSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                             IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                             Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind ViewModel.NoticeActionText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasNoticeAction, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RunNoticeActionCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    </StackPanel>

                    <ProgressRing x:Uid="BusyRing" Grid.Row="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" />

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Spacing="8"
                                Visibility="{x:Bind ShowEmptyText(ViewModel.IsEmpty, ViewModel.IsBusy), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Uid="ClearSearchButton" Content="Clear search" HorizontalAlignment="Center"
                                         Command="{x:Bind ViewModel.ClearSearchCommand}"
                                         Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                    </StackPanel>

                    <ListView x:Uid="EntriesList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="OnEntryClick"
                              Padding="0,0,0,24">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryViewModel">
                                <Grid Padding="16,10" ColumnSpacing="16" CornerRadius="6" BorderThickness="1"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="24" Height="24" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind KindLabel}">
                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="24" Height="24"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                  Visibility="{x:Bind NoIcon, Mode=OneWay}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <TextBlock services:Highlight.Text="{x:Bind Name}" services:Highlight.Query="{x:Bind Query}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Secondary}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE83D;" FontSize="14" Visibility="{x:Bind IsProtected}"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  ToolTipService.ToolTip="{x:Bind ProtectedText}"
                                                  AutomationProperties.Name="{x:Bind ProtectedText}" />
                                        <Border Visibility="{x:Bind ShowSection}" CornerRadius="4" Padding="6,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind SectionLabel}" FontSize="11" />
                                        </Border>
                                        <Border Visibility="{x:Bind ShowShiftBadge}" CornerRadius="4" Padding="6,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                ToolTipService.ToolTip="{x:Bind ShiftTooltip}">
                                            <TextBlock x:Uid="ShiftBadge" Text="Shift + right-click" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="220"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" MinWidth="44" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ToggleSwitch MinWidth="0" OnContent="" OffContent=""
                                                      AutomationProperties.Name="{x:Bind Name}"
                                                      IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" />
                                    </StackPanel>

                                    <Button x:Uid="MoreButton" Grid.Column="4" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                            AutomationProperties.Name="More options" ToolTipService.ToolTip="More options">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem x:Uid="Menu_Details" Text="Details" Command="{x:Bind ShowDetailsCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_SearchWeb" Text="Search the web" Command="{x:Bind SearchWebCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Menu_Edit" Text="Edit" Command="{x:Bind EditCommand}" IsEnabled="{x:Bind CanEdit}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_MoveUp" Text="Move up" Command="{x:Bind MoveUpCommand}" Visibility="{x:Bind CanMove}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_MoveDown" Text="Move down" Command="{x:Bind MoveDownCommand}" Visibility="{x:Bind CanMove}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_Rename" Text="Rename" Command="{x:Bind RenameCommand}" IsEnabled="{x:Bind CanRename}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_OpenLocation" Text="Open location" Command="{x:Bind OpenLocationCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="Menu_CopyLocation" Text="Copy location" Command="{x:Bind CopyLocationCommand}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="Menu_Delete" Text="Delete" Command="{x:Bind DeleteCommand}" IsEnabled="{x:Bind CanDelete}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Settings page -->
                <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed" />

                <!-- Edit form: closes with Save, Cancel or Esc -->
                <Grid x:Name="EditOverlay" Background="#80000000"
                      Visibility="{x:Bind ToVisible(ViewModel.IsEditOpen), Mode=OneWay}">
                    <Border MaxWidth="560" MaxHeight="640" Margin="24" Padding="24" CornerRadius="8"
                            BorderThickness="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Editing.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="1">
                                <StackPanel Spacing="12" Margin="0,0,16,0">
                                    <TextBox x:Uid="Edit_Command" Text="{x:Bind ViewModel.Editing.Command, Mode=TwoWay}"
                                             Visibility="{x:Bind ToVisible(ViewModel.Editing.HasCommand), Mode=OneWay}" />
                                    <StackPanel Spacing="4" Visibility="{x:Bind ToVisible(ViewModel.Editing.IsValue), Mode=OneWay}">
                                        <TextBox x:Uid="Edit_Value" Text="{x:Bind ViewModel.Editing.ValueText, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.Editing.ValueHint, Mode=OneWay}" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="12" Visibility="{x:Bind ToVisible(ViewModel.Editing.ShowVerbFields), Mode=OneWay}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Uid="Edit_Icon" Text="{x:Bind ViewModel.Editing.Icon, Mode=TwoWay}" />
                                            <Button x:Uid="Edit_ChooseIcon" Grid.Column="1" VerticalAlignment="Bottom"
                                                    Command="{x:Bind ViewModel.OpenIconPickerCommand}" />
                                        </Grid>
                                        <ComboBox x:Uid="Edit_Position" SelectedIndex="{x:Bind ViewModel.Editing.PositionIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="Position_Default" />
                                            <ComboBoxItem x:Uid="Position_Top" />
                                            <ComboBoxItem x:Uid="Position_Bottom" />
                                        </ComboBox>
                                        <CheckBox x:Uid="Attr_Shield" IsChecked="{x:Bind ViewModel.Editing.Shield, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Attr_Extended" IsChecked="{x:Bind ViewModel.Editing.Extended, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Attr_OnlyBrowser" IsChecked="{x:Bind ViewModel.Editing.OnlyInBrowserWindow, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Attr_NoWorkingDir" IsChecked="{x:Bind ViewModel.Editing.NoWorkingDirectory, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Attr_NeverDefault" IsChecked="{x:Bind ViewModel.Editing.NeverDefault, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Attr_ShowDisabled" IsChecked="{x:Bind ViewModel.Editing.ShowAsDisabledIfHidden, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Editing.Error, Mode=OneWay}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Uid="EditCancel" Command="{x:Bind ViewModel.CancelEditCommand}" />
                                <Button x:Uid="EditSave" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveEditCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- New item form: closes with Create, Cancel or Esc -->
                <Grid x:Name="NewItemOverlay" Background="#80000000"
                      Visibility="{x:Bind ToVisible(ViewModel.IsNewOpen), Mode=OneWay}">
                    <Border MaxWidth="600" MaxHeight="700" Margin="24" Padding="24" CornerRadius="8"
                            BorderThickness="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Creating.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="1">
                                <StackPanel Spacing="12" Margin="0,0,16,0">
                                    <RadioButtons x:Uid="New_Type" SelectedIndex="{x:Bind ViewModel.Creating.TypeIndex, Mode=TwoWay}"
                                                  Visibility="{x:Bind ToVisible(ViewModel.Creating.ShowTypeChoice), Mode=OneWay}">
                                        <RadioButton x:Uid="New_TypeVerb" />
                                        <RadioButton x:Uid="New_TypeHandler" />
                                    </RadioButtons>

                                    <!-- Shell verb -->
                                    <StackPanel Spacing="12" Visibility="{x:Bind ToVisible(ViewModel.Creating.IsVerb), Mode=OneWay}">
                                        <TextBox x:Uid="New_Name" Text="{x:Bind ViewModel.Creating.Name, Mode=TwoWay}" />
                                        <RadioButtons x:Uid="New_Mode" SelectedIndex="{x:Bind ViewModel.Creating.ModeIndex, Mode=TwoWay}">
                                            <RadioButton x:Uid="New_ModeSingle" />
                                            <RadioButton x:Uid="New_ModeSubmenu" />
                                            <RadioButton x:Uid="New_ModeShared" />
                                        </RadioButtons>

                                        <StackPanel Spacing="12" Visibility="{x:Bind ToVisible(ViewModel.Creating.ShowSingle), Mode=OneWay}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Uid="New_Program" Text="{x:Bind ViewModel.Creating.Program, Mode=TwoWay}" />
                                                <Button x:Uid="New_Browse" Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseProgram" />
                                            </Grid>
                                            <TextBox x:Uid="New_Arguments" Text="{x:Bind ViewModel.Creating.Arguments, Mode=TwoWay}" />
                                            <CheckBox x:Uid="New_PassSelected" IsChecked="{x:Bind ViewModel.Creating.PassSelected, Mode=TwoWay}"
                                                      Visibility="{x:Bind ToVisible(ViewModel.Creating.ShowSelectionOption), Mode=OneWay}" />
                                            <CheckBox x:Uid="New_Hidden" IsChecked="{x:Bind ViewModel.Creating.Hidden, Mode=TwoWay}" />
                                            <CheckBox x:Uid="New_RunAs" IsChecked="{x:Bind ViewModel.Creating.RunAsAdministrator, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Spacing="8" Visibility="{x:Bind ToVisible(ViewModel.Creating.ShowSubmenu), Mode=OneWay}">
                                            <TextBlock x:Uid="New_Children" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Creating.Children}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:NewChildViewModel">
                                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Uid="New_ChildName" Text="{x:Bind Name, Mode=TwoWay}" />
                                                            <TextBox x:Uid="New_ChildCommand" Grid.Column="1" Text="{x:Bind Command, Mode=TwoWay}" />
                                                            <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRemoveChild" VerticalAlignment="Center"
                                                                    x:Uid="New_RemoveChild">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Uid="New_AddChild" Command="{x:Bind ViewModel.Creating.AddChildCommand}" />
                                        </StackPanel>

                                        <StackPanel Spacing="4" Visibility="{x:Bind ToVisible(ViewModel.Creating.ShowShared), Mode=OneWay}">
                                            <TextBlock x:Uid="New_Shared" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Creating.SharedChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SharedChoiceViewModel">
                                                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Uid="Edit_Icon" Text="{x:Bind ViewModel.Creating.Icon, Mode=TwoWay}" />
                                            <Button x:Uid="Edit_ChooseIcon" Grid.Column="1" VerticalAlignment="Bottom"
                                                    Command="{x:Bind ViewModel.OpenIconPickerCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Shell extension -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind ToVisible(ViewModel.Creating.IsHandler), Mode=OneWay}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Uid="New_Guid" Text="{x:Bind ViewModel.Creating.GuidText, Mode=TwoWay}" />
                                            <Button x:Uid="New_PasteGuid" Grid.Column="1" VerticalAlignment="Bottom"
                                                    Command="{x:Bind ViewModel.PasteGuidCommand}" />
                                        </Grid>
                                        <TextBlock x:Uid="New_GuidHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <CheckBox x:Uid="New_AllUsers" IsChecked="{x:Bind ViewModel.Creating.AllUsers, Mode=TwoWay}"
                                              Visibility="{x:Bind ToVisible(ViewModel.Creating.ShowAllUsers), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.Creating.Error, Mode=OneWay}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Uid="NewCancel" Command="{x:Bind ViewModel.CancelNewCommand}" />
                                <Button x:Uid="NewCreate" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveNewCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- New shortcut form (Send to): closes with Create, Cancel or Esc -->
                <Grid x:Name="NewTargetOverlay" Background="#80000000"
                      Visibility="{x:Bind ToVisible(ViewModel.IsTargetOpen), Mode=OneWay}">
                    <Border MaxWidth="560" MaxHeight="520" Margin="24" Padding="24" CornerRadius="8"
                            BorderThickness="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Targeting.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBox x:Uid="NewTarget_Name" Text="{x:Bind ViewModel.Targeting.Name, Mode=TwoWay}"
                                     Visibility="{x:Bind ToVisible(ViewModel.Targeting.ShowName), Mode=OneWay}" />
                            <ComboBox x:Uid="NewTarget_Group" ItemsSource="{x:Bind ViewModel.Targeting.Groups}" DisplayMemberPath="Label"
                                      SelectedIndex="{x:Bind ViewModel.Targeting.GroupIndex, Mode=TwoWay}"
                                      Visibility="{x:Bind ToVisible(ViewModel.Targeting.ShowGroup), Mode=OneWay}" />
                            <TextBox Header="{x:Bind ViewModel.Targeting.TargetHeader, Mode=OneWay}" Text="{x:Bind ViewModel.Targeting.Target, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="NewTarget_BrowseFile" Click="OnBrowseTargetFile"
                                        Visibility="{x:Bind ToVisible(ViewModel.Targeting.ShowFileButton), Mode=OneWay}" />
                                <Button x:Uid="NewTarget_BrowseFolder" Click="OnBrowseTargetFolder"
                                        Visibility="{x:Bind ToVisible(ViewModel.Targeting.ShowFolderButton), Mode=OneWay}" />
                            </StackPanel>
                            <TextBox x:Uid="NewTarget_Arguments" Text="{x:Bind ViewModel.Targeting.Arguments, Mode=TwoWay}"
                                     Visibility="{x:Bind ToVisible(ViewModel.Targeting.ShowArguments), Mode=OneWay}" />
                            <CheckBox x:Uid="New_AllUsers" IsChecked="{x:Bind ViewModel.Targeting.AllUsers, Mode=TwoWay}"
                                      Visibility="{x:Bind ToVisible(ViewModel.Targeting.ShowAllUsers), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Targeting.Error, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Uid="NewCancel" Command="{x:Bind ViewModel.CancelTargetCommand}" />
                                <Button x:Uid="NewCreate" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveTargetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Icon picker (above the edit form): a click outside the card closes it -->
                <Grid x:Name="IconPickerOverlay" Background="#80000000" Tapped="OnIconPickerBackdropTapped"
                      Visibility="{x:Bind ToVisible(ViewModel.IsIconPickerOpen), Mode=OneWay}">
                    <Border Tapped="OnCardTapped" MaxWidth="640" MaxHeight="600" Margin="24" Padding="24" CornerRadius="8"
                            BorderThickness="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="IconPicker_Title" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IconFileBox" x:Uid="IconPicker_File" Text="{x:Bind ViewModel.IconPicker.FilePath, Mode=TwoWay}" />
                                <Button x:Uid="IconPicker_Load" Grid.Column="1" Click="OnLoadIconFile" />
                                <Button x:Uid="IconPicker_Browse" Grid.Column="2" Click="OnBrowseIconFile" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="shell32.dll" Tag="shell32.dll" Click="OnQuickIconFile" />
                                <Button Content="imageres.dll" Tag="imageres.dll" Click="OnQuickIconFile" />
                                <Button Content="moricons.dll" Tag="moricons.dll" Click="OnQuickIconFile" />
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IconPicker.IsLoading, Mode=OneWay}" />
                            </StackPanel>
                            <GridView Grid.Row="3" ItemsSource="{x:Bind ViewModel.IconPicker.Items}" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="OnIconClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IconPickItem">
                                        <Image Source="{x:Bind Image, Mode=OneWay}" Width="32" Height="32" Margin="6"
                                               ToolTipService.ToolTip="{x:Bind Index}" />
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <Grid Grid.Row="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.IconPicker.Status, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Uid="IconPicker_Close" Grid.Column="1" Command="{x:Bind ViewModel.CloseIconPickerCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Details overlay: a click outside the card closes it -->
                <Grid x:Name="DetailsOverlay" Background="#80000000" Tapped="OnOverlayTapped"
                      Visibility="{x:Bind ToVisible(ViewModel.IsDetailsOpen), Mode=OneWay}">
                    <Border Tapped="OnCardTapped" MaxWidth="520" MaxHeight="560" Margin="24" Padding="24" CornerRadius="8"
                            BorderThickness="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.DetailsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DetailRow">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Uid="DetailsCopy" Command="{x:Bind ViewModel.CopyDetailsLocationCommand}" />
                                <Button x:Uid="DetailsClose" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CloseDetailsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
