<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure domain layer: models, rules and service contracts. No Windows APIs here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NeoContext.Core</RootNamespace>
  </PropertyGroup>

  <!-- Dictionaries that ship with the app (ContextMenuManager schema, GPL-3.0, with Turkish texts added). -->
  <ItemGroup>
    <EmbeddedResource Include="Dictionaries\*.xml;Dictionaries\*.ini" LogicalName="NeoContext.Dictionaries.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
