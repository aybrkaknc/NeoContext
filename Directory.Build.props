<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>0.1.0</Version>
    <Authors>NeoContext contributors</Authors>
    <Product>NeoContext</Product>
    <Copyright>Copyright (C) NeoContext contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aybrkaknc/NeoContext</RepositoryUrl>

    <!-- Windows 10 1809 is the oldest release Windows App SDK supports. -->
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows10'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Every library may expose internals to the test project. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <InternalsVisibleTo Include="NeoContext.Tests" />
  </ItemGroup>
</Project>
